# Names only. Real values go in .env, which is not committed.
OPENROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Coach service (the coach-api service on Railway). COACH_ENABLED=false switches it off. PORT is typed in the Railway dashboard.
COACH_ENABLED=true
PORT=
# COROS has no API key. Login tokens live in the coros_tokens table (see docs/decisions.md).
COROS_MCP_URL=https://mcpeu.coros.com/mcp
# Web app (put these in web/.env.local). Public values only. Never put the service role key in web/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web app, server side only (never NEXT_PUBLIC_): the private address of the coach service, like http://coach-api.railway.internal:8000
COACH_API_URL=
